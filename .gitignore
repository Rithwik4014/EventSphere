# ==============================================================================
# EventSphere - Production .gitignore
# ==============================================================================

# 1. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example

# 4. IDE, Editor & Operating System Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 5. Runtime & Generated Application Files
*.log
logs/
instance/
.webassets-cache
*.sqlite3
*.db

# 6. Testing, Code Coverage & Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# 7. Distribution & Packaging
build/
dist/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg
*.egg-info/
MANIFEST

# 8. Machine Learning & Model Artifacts
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.pth
models/generated/
