# =============================================================
# EventSphere Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NOTE: Never commit '.env' to version control.
# =============================================================

# Flask Environment
FLASK_ENV=development
PORT=5050
SECRET_KEY=replace-with-a-cryptographically-secure-secret-key
BASE_URL=http://127.0.0.1:5050

# MongoDB Atlas Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eventsphere_db?retryWrites=true&w=majority
DB_NAME=eventsphere_db

# Gmail SMTP Password Recovery Configuration
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate a 16-character App Password under "App passwords" for "Mail"
# 3. Paste the Gmail address and App Password below (without spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_DEFAULT_SENDER="EventSphere <your_gmail_address@gmail.com>"
